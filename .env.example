# Safe local configuration for the research project.
# Public market-data planning does not require credentials.
# Do not add trading keys, account IDs, withdrawal settings, or secret tokens here.

# Runtime environment. Supported values: development, test, production.
CROSS_VENUE_ENV=development

# Internal timestamp policy defaults to UTC.
CROSS_VENUE_TIMEZONE=UTC

# Minimum logging level. Supported values: DEBUG, INFO, WARNING, ERROR, CRITICAL.
CROSS_VENUE_LOG_LEVEL=INFO

# Local directories used by future data and report tooling.
CROSS_VENUE_DATA_DIRECTORY=data
CROSS_VENUE_REPORT_DIRECTORY=reports
